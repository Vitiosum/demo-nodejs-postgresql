doctype html
html(lang="fr")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="theme-color" content="#13172e")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/cc-brand.css")
    link(rel="stylesheet" href="/demo.css")
    link(rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 101 116'%3E%3Cpolygon fill='%23AB2B4A' points='100.423 29.134 100.423 86.868 89.721 73.062 83.76 58.003 83.756 58.003 89.418 42.731'/%3E%3Cpolygon fill='%23E87A68' points='.429 29.134 .429 86.868 9.889 73.481 17.092 58.003 17.096 58.003 9.773 43.319'/%3E%3Cpolygon fill='%23D74D4E' points='83.756 58.003 52.241 60.003 17.092 58.003 31.76 29.134 50.426 .269 70.722 31.961'/%3E%3Cpolygon fill='%23BD3246' points='100.423 29.134 83.756 58.003 50.426 .269'/%3E%3Cpolygon fill='%23F19175' points='50.426 .269 17.092 58.003 .425 29.134'/%3E%3Cpolygon fill='%23CF3942' points='83.756 58.003 72.365 82.931 50.426 115.737 27.849 81.83 17.092 58.003'/%3E%3Cpolygon fill='%23E0625B' points='50.426 115.737 .425 86.868 17.092 58.003'/%3E%3Cpolygon fill='%239A244F' points='50.422 115.737 100.423 86.868 83.756 58.003'/%3E%3C/svg%3E")
    title= title || 'Node.js + PostgreSQL · Démo Clever Cloud'
  body
    header.cc-topbar
      .cc-container.cc-topbar__inner
        a(href="https://www.clever.cloud" target="_blank" rel="noopener" aria-label="Clever Cloud")
          != ccLogo
        span.cc-topbar__sep
        .cc-topbar__demo
          small Démo
          | Node.js + PostgreSQL
        span.cc-topbar__spacer
        nav.cc-topbar__nav(aria-label="Statut")
          span.cc-pill.cc-pill--mono.cc-hide-sm= cc.stack
          if cc.live
            span.cc-pill.cc-pill--live
              span.cc-dot
              | Live on Clever Cloud
          else
            span.cc-pill.cc-pill--muted
              span.cc-dot.cc-dot--muted
              | Local · hors Clever Cloud
          a.cc-pill.cc-pill--gradient(href="https://academy.clever.cloud/" target="_blank" rel="noopener") Se certifier ↗

    main
      block content

    footer.cc-footer
      .cc-container
        .cc-footer__inner
          .cc-footer__brand
            != ccLogo
            p PaaS européen entièrement managé. Déployez en git push, la plateforme s'occupe du reste.
            .cc-trust
              span ISO 27001
              span HDS
              span HÉBERGÉ EN FRANCE
          div
            h4 Documentation
            ul
              li: a(href="https://www.clever.cloud/developers/doc/applications/javascript/nodejs/" target="_blank" rel="noopener") Runtime Node.js
              li: a(href="https://www.clever.cloud/developers/doc/addons/postgresql/" target="_blank" rel="noopener") Add-on PostgreSQL
              li: a(href="https://console.clever-cloud.com" target="_blank" rel="noopener") Console Clever Cloud
          div
            h4 Aller plus loin
            ul
              li: a.is-cert(href="https://academy.clever.cloud/" target="_blank" rel="noopener") Certification Clever Cloud ↗
              li: a(href="https://github.com/Vitiosum/demo-nodejs-postgresql" target="_blank" rel="noopener") Code source sur GitHub
              li: a(href="https://www.clever.cloud" target="_blank" rel="noopener") clever.cloud
        .cc-footer__bottom
          span Démo réalisée par l'équipe avant-vente Clever Cloud
          span © 2026 Clever Cloud

    #toast.demo-toast(role="status" aria-live="polite")
      span#toast-msg
      button.demo-toast__close(type="button" aria-label="Fermer") ×
    script(src="/js/demo.js")
