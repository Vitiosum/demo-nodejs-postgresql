extends layout

mixin kv(label, value)
  div
    dt= label
    if value
      dd= value
    else
      dd.is-empty —

block content
  - var n = values.length
  - var rowsLabel = n + ' ligne' + (n > 1 ? 's' : '')

  section.cc-hero
    .cc-container
      .cc-eyebrow.cc-reveal(style="--i:0") Runtime Node.js · Add-on PostgreSQL
      h1.cc-hero__title.cc-reveal(style="--i:1") Node.js + PostgreSQL, #[span.cc-grad-text déployé en un push.]
      p.cc-hero__lead.cc-reveal(style="--i:2") Une app Express connectée à un add-on PostgreSQL managé. #[strong Aucun Dockerfile, aucun serveur à gérer] : Clever Cloud détecte le runtime, injecte les variables de connexion et redéploie à chaque #[span.cc-kbd git push].
      ul.cc-facts.cc-reveal(style="--i:3")
        li Build automatique depuis Git
        li Add-on PostgreSQL lié
        li HTTPS et domaine inclus
        li Scaling horizontal en un clic

  section.cc-section(style="padding-top:0")
    .cc-container
      .cc-cert.cc-reveal(style="--i:4")
        != ccBadge
        div
          .cc-cert__kicker Clever Cloud Academy
          h2.cc-cert__title Devenez #[span.cc-grad-text certifié Clever Cloud]
          p.cc-cert__text Deux parcours officiels, de la théorie au déploiement avancé. Le badge numérique est délivré automatiquement dès la validation.
          .cc-tracks
            a.cc-track(href="https://academy.clever.cloud/course/view.php?id=2" target="_blank" rel="noopener")
              span.cc-track__num 01
              span
                span.cc-track__name Cloud Computing Fundamentals
                br
                span.cc-track__desc Concepts, architectures, modèles IaaS · PaaS · FaaS.
            a.cc-track(href="https://academy.clever.cloud/course/section.php?id=18" target="_blank" rel="noopener")
              span.cc-track__num 02
              span
                span.cc-track__name Advanced Deployment
                br
                span.cc-track__desc Maîtriser le déploiement d'applications sur Clever Cloud.
          .cc-cert__actions
            a.cc-btn.cc-btn--gradient(href="https://academy.clever.cloud/" target="_blank" rel="noopener") Obtenir ma certification #[span.cc-btn__arrow →]
            span.cc-cert__note academy.clever.cloud · développeurs, partenaires, équipes

  section.cc-section
    .cc-container
      .cc-grid.cc-grid--2
        .cc-card.cc-card--pad.cc-reveal(style="--i:5")
          .cc-section__head
            h2.cc-section__title Valeurs stockées
            span.cc-section__sub #[span#count= rowsLabel] · table #[span.cc-kbd values]
          form#createForm.cc-form-row(method="post" action="/values")
            input#value.cc-input(type="text" name="value" placeholder="Une valeur à persister…" maxlength="32" autocomplete="off" aria-label="Valeur")
            button#create.cc-btn.cc-btn--gradient(type="submit") Ajouter
          ul#values.cc-list.cc-mt-2
            if n > 0
              each row in values
                li.cc-row(id='row-' + row.id data-id=row.id)
                  span.cc-row__id ##{row.id}
                  .cc-row__main
                    .cc-row__title= row.value
                    .cc-row__meta JSONB · PostgreSQL
                  .cc-row__actions
                    button.cc-btn.cc-btn--sm.cc-btn--danger(type="button" data-delete=row.id) Supprimer
            else
              li.cc-empty
                strong Aucune valeur pour l'instant
                | Ajoutez-en une ci-dessus : elle sera persistée dans PostgreSQL.

        .cc-platform.cc-reveal(style="--i:6")
          .cc-platform__head
            h3 Vu depuis Clever Cloud
            if cc.live
              span.cc-pill.cc-pill--ok
                span.cc-dot
                | Production
            else
              span.cc-pill.cc-pill--muted Local · hors Clever Cloud
          dl.cc-kv
            +kv('Application', cc.appName)
            +kv('Instance', cc.instance)
            +kv('Type d\'instance', cc.instanceType)
            +kv('Commit déployé', cc.commit)
            +kv('App ID', cc.appId)
            +kv('Déploiement', cc.deployment)
            div
              dt PostgreSQL
              dd
                if cc.pgVersion
                  | #{cc.pgVersion} · 
                span#pg-rows= rowsLabel
            +kv('Runtime', 'Node.js ' + cc.nodeVersion + ' · Express ' + cc.expressVersion)
          .cc-platform__foot Variables injectées automatiquement par la plateforme : #[a(href="https://www.clever.cloud/developers/doc/reference/reference-environment-variables/" target="_blank" rel="noopener") référence].

  section.cc-section
    .cc-container
      .cc-section__head.cc-reveal(style="--i:7")
        h2.cc-section__title Ce que Clever Cloud fait pour cette app
        span.cc-section__sub Sans devops, sans Dockerfile
      .cc-grid.cc-grid--3
        .cc-card.cc-card--accent.cc-reveal(style="--i:8")
          .cc-card__label Déploiement
          .cc-card__title.cc-mt-1 git push → build → run
          p.cc-card__hint Runtime détecté, dépendances installées, redémarrage sans interruption.
        .cc-card.cc-card--accent.cc-reveal(style="--i:9")
          .cc-card__label Données
          .cc-card__title.cc-mt-1 PostgreSQL managé
          p.cc-card__hint Sauvegardes quotidiennes, URI directe, montée de gamme sans migration.
        .cc-card.cc-card--accent.cc-reveal(style="--i:10")
          .cc-card__label Confiance
          .cc-card__title.cc-mt-1 Hébergé en France
          p.cc-card__hint ISO 27001, HDS, hors de portée des lois extraterritoriales.
