extends layout

block content
  .cc-container
    section.fi-errcard
      p.fi-errcard__code
        | Erreur
        if error && error.status
          |  #{error.status}
      h1= message
      p La page demandée n'a pas pu être servie par l'application.
      if error && error.stack
        pre= error.stack
      a.cc-btn.cc-btn--gradient(href="/") Retour au fichier
